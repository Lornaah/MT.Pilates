{
  "name": "mt-pilates-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Build CSS/JS de l'application M.T.Pilates (Tailwind v4 + Basecoat), piloté par Maven.",
  "scripts": {
    "build:css": "tailwindcss -i src/main/frontend/css/app.css -o target/classes/static/css/app.css --minify",
    "build:vendor": "node src/main/frontend/copy-vendor.mjs",
    "build": "npm run build:vendor && npm run build:css",
    "watch:css": "tailwindcss -i src/main/frontend/css/app.css -o target/classes/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "alpinejs": "3.17.5",
    "basecoat-css": "1.1.0",
    "chart.js": "4.6.1",
    "htmx.org": "2.0.11",
    "lucide-static": "0.462.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  }
}
